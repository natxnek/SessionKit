option ClientOutput = "src/client/PacketsClient.luau"
option ServerOutput = "src/server/PacketsServer.luau"
option Casing = Pascal
option RemoteScope = "SKIT"

scope SessionKit {
    --Full snapshot, sent once when a session opens on the client
    function GetData {
        Yield: Coroutine,
        Return: string?,
    }

    event SetValue {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
        Data: (string[], string)
    }

    event ArrayInsert {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
        Data: (string[], string, u32)
    }

    event ArrayRemove {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
        Data: (string[], u32)
    }
}